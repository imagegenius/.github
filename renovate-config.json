{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "timezone": "Australia/Melbourne",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "commitMessageExtra": "({{manager}})",
    "additionalBranchPrefix": "{{manager}}-"
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**"
  ],
  "registryAliases": {
    "mirror.gcr.io": "docker.io"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process annotated dependencies",
      "managerFilePatterns": ["/.*/"],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat",
      "commitMessageExtra": "({{currentVersion}} → {{newVersion}})"
    },
    {
      "matchUpdateTypes": ["minor"],
      "semanticCommitType": "feat",
      "commitMessageExtra": "({{currentVersion}} → {{newVersion}})"
    },
    {
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "semanticCommitType": "feat",
      "commitMessageExtra": "({{currentVersion}} → {{newVersion}})"
    },
    {
      "matchUpdateTypes": ["patch"],
      "semanticCommitType": "fix",
      "commitMessageExtra": "({{currentVersion}} → {{newVersion}})"
    },
    {
      "matchUpdateTypes": ["digest"],
      "semanticCommitType": "fix",
      "commitMessageExtra": "({{currentDigestShort}} → {{newDigestShort}})"
    },
    {
      "matchDatasources": ["docker"],
      "semanticCommitScope": "container",
      "commitMessageTopic": "image {{depName}}"
    },
    {
      "matchDatasources": ["helm"],
      "semanticCommitScope": "helm",
      "commitMessageTopic": "chart {{depName}}"
    },
    {
      "matchManagers": ["gomod"],
      "semanticCommitScope": "go",
      "commitMessageTopic": "module {{depName}}"
    },
    {
      "matchManagers": ["cargo"],
      "semanticCommitScope": "rust",
      "commitMessageTopic": "crate {{depName}}"
    },
    {
      "matchManagers": ["npm"],
      "semanticCommitScope": "npm",
      "commitMessageTopic": "dependency {{depName}}"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}"
    },
    {
      "matchDatasources": ["github-releases"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "github-release",
      "commitMessageTopic": "release {{depName}}"
    },
    {
      "matchManagers": ["mise"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "mise",
      "commitMessageTopic": "tool {{depName}}"
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["type/major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "labels": ["type/minor"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "labels": ["type/major"],
      "additionalBranchPrefix": "major-"
    },
    {
      "matchUpdateTypes": ["patch"],
      "labels": ["type/patch"]
    },
    {
      "matchUpdateTypes": ["digest"],
      "labels": ["type/digest"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "groupSlug": "mise-tools",
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["go"],
      "matchFileNames": [".mise/config.toml"],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["rust"],
      "matchFileNames": [".mise/config.toml"],
      "groupName": "Rust toolchain",
      "groupSlug": "rust-toolchain"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["node"],
      "matchFileNames": [".mise/config.toml"],
      "groupName": "Node toolchain",
      "groupSlug": "node-toolchain"
    },
    {
      "matchCategories": ["golang", "js", "python", "rust"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchSourceUrls": ["https://github.com/imagegenius/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Excluded devtools still automerge; a bad bump only fails CI.",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "matchDepNames": [
        "!aqua:dadav/helm-schema",
        "!helm-unittest/helm-unittest",
        "!oxfmt",
        "!shellcheck"
      ],
      "automerge": false
    }
  ]
}
